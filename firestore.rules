rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "BPPIusuVnOgeOMKIP3ubP1QqVVY2";
    }

    match /orders/{orderId} {

      allow create: if request.resource.data.id == orderId
        && request.resource.data.id is string
        && request.resource.data.customer.name is string
        && request.resource.data.total is number
        && request.resource.data.status in [
          "Menunggu",
          "Diproses",
          "Siap Diambil",
          "Selesai",
          "Dibatalkan"
        ];

      allow read: if isAdmin();

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(["status", "updatedAt"])
        && request.resource.data.status in [
          "Menunggu",
          "Diproses",
          "Siap Diambil",
          "Selesai",
          "Dibatalkan"
        ];
    }

    match /meta/orderSequence {

      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(["date", "count"])
        && request.resource.data.date is string
        && request.resource.data.date.matches("^[0-9]{8}$")
        && request.resource.data.count == 1;

      allow update: if request.resource.data.keys().hasOnly(["date", "count"])
        && request.resource.data.date is string
        && request.resource.data.date.matches("^[0-9]{8}$")
        && (
          (
            request.resource.data.date == resource.data.date
            && request.resource.data.count == resource.data.count + 1
          )
          ||
          (
            request.resource.data.date != resource.data.date
            && request.resource.data.count == 1
          )
        );
    }
  }
}
